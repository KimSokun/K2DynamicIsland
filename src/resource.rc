#include <windows.h>

101 ICON "app_icon.ico"

1 VERSIONINFO
FILEVERSION 1,1,3,0
PRODUCTVERSION 1,1,3,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "K2 Project"
            VALUE "FileDescription", "K2 Dynamic Island"
            VALUE "FileVersion", "1.1.3.0"
            VALUE "InternalName", "K2DynamicIsland"
            VALUE "LegalCopyright", "Copyright (C) 2026 K2 Dynamic Island Contributors"
            VALUE "OriginalFilename", "K2DynamicIsland.exe"
            VALUE "ProductName", "K2 Dynamic Island"
            VALUE "ProductVersion", "1.1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
